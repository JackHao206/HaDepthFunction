<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 使用 .NET Framework 4.8：halcondotnet.dll(dotnet35) 的官方匹配运行时，
         其 EXE 为经典 CLR 宿主，可正常加载 halcon.dll（.NET Core/5+ 的 apphost 宿主会触发 halcon.dll 原生崩溃）。 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>DepthFusionApp</AssemblyName>
    <RootNamespace>DepthFusionApp</RootNamespace>
    <!-- Halcon 安装目录：优先取环境变量 HALCONROOT，没有则使用下面的默认值 -->
    <HalconRoot Condition="'$(HALCONROOT)' != ''">$(HALCONROOT)</HalconRoot>
    <HalconRoot Condition="'$(HalconRoot)' == ''">D:\MVTec\HALCON-24.11-Progress-Steady</HalconRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Halcon 托管包装程序集（dotnet35 版本，运行于 .NET Framework 3.5+） -->
    <Reference Include="halcondotnet">
      <HintPath>$(HalconRoot)\bin\dotnet35\halcondotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
